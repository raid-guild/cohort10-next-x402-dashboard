# Frontend environment for RaidGuild x402 Dashboard
# Copy this file to `.env.local` for local dev
# and to your hosting provider env settings for production.

# --- Supabase ---
# Find these in Supabase project settings under API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=


# --- WalletConnect / Reown AppKit ---
# Get a project ID from https://dashboard.reown.com (or WalletConnect Cloud)
# The app has a built-in dev fallback, but you should override it in real deployments.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- x402 Facilitator (Base / USDC) ---
X402_FACILITATOR_URL=https://cohort10-x402-go.vercel.app
X402_FACILITATOR_API_KEY=
X402_NETWORK=base
USDC_BASE_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
SERVICE_RECIPIENT_ADDRESS=
PRICE_IN_USDC=0.1

# --- Client display (pricing/recipient) ---
NEXT_PUBLIC_PRICE_IN_USDC=0.1
NEXT_PUBLIC_SERVICE_RECIPIENT_ADDRESS=
NEXT_PUBLIC_FACILITATOR_URL=https://cohort10-x402-go.vercel.app

# --- Documentation ---
NEXT_PUBLIC_DOCS_URL=https://cohort10-x402-docs.vercel.app/